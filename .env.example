OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=qwen/qwen3-next-80b-a3b-instruct:free
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Необязательно: отправка писем восстановления пароля через Resend.
RESEND_API_KEY=
PASSWORD_RESET_FROM=Homelix <no-reply@example.com>

# Только для локальной демонстрации: API вернёт ссылку восстановления в интерфейс.
# Не включайте в публичном production.
HOMELIX_ALLOW_RESET_PREVIEW=false
