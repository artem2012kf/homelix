OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=qwen/qwen3-next-80b-a3b-instruct:free
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Секрет для подписания кодов подтверждения почты. В production задайте случайную строку от 32 символов.
HOMELIX_AUTH_SECRET=

# Gmail SMTP. Включите двухэтапную аутентификацию и создайте отдельный пароль приложения Google.
GMAIL_SMTP_USER=your-account@gmail.com
GMAIL_SMTP_APP_PASSWORD=your-16-character-app-password
EMAIL_FROM=ХОЛЛ <your-account@gmail.com>

# Необязательно: значения по умолчанию уже подходят для Gmail SMTP через SSL.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_EHLO_NAME=hall-app

# Только для закрытой демонстрации. В публичном production оставьте false.
HOMELIX_ALLOW_EMAIL_VERIFICATION_PREVIEW=false
HOMELIX_ALLOW_RESET_PREVIEW=false

# Обновляемый курс для английской версии.
EXCHANGE_RATE_URL=https://open.er-api.com/v6/latest/RUB
RUB_PER_USD_FALLBACK=90
