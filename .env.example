OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=qwen/qwen3-next-80b-a3b-instruct:free
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Секрет для подписания кодов подтверждения почты. В production задайте случайную строку от 32 символов.
HOMELIX_AUTH_SECRET=

# Отправка писем подтверждения и восстановления через Resend.
RESEND_API_KEY=
EMAIL_FROM=ХОЛЛ <no-reply@example.com>
PASSWORD_RESET_FROM=ХОЛЛ <no-reply@example.com>

# Только для закрытой демонстрации. В публичном production оставьте false.
HOMELIX_ALLOW_EMAIL_VERIFICATION_PREVIEW=false
HOMELIX_ALLOW_RESET_PREVIEW=false

# Обновляемый курс для английской версии.
EXCHANGE_RATE_URL=https://open.er-api.com/v6/latest/RUB
RUB_PER_USD_FALLBACK=90
